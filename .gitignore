# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# OS / office lock files
.DS_Store
Thumbs.db
.~lock.*#
*.tmp

# ---------------------------------------------------------------- big inputs
# Trained/merged models + GGUF (GBs - never commit)
models/
out/
*.gguf

# UMLS (licence required) and MeSH (too large) - download separately
Data/UMLS/
Data/MeSH/

# Fine-tuning training data (regenerable via --dump-finetune; scp to cluster)
Data/finetune/

# Corpus parts we do not read: the pipeline uses nlm_chem_test.pubtator and the
# NCBI *.txt files. ALL/ is the full BioC dump (16 MB) and the .zip files are
# duplicates of the .txt next to them - both re-downloadable.
Data/NLM-Chem/ALL/
Data/NCBI/*.zip

# spaCy models (downloaded locally)
en_core_web_sm*/
en_core_sci_sm*/

# Retrieval caches and FAISS indices (9.8 GB - rebuilt by build_umls_faiss.py)
src/improvements/cache/
src/candidate-generation/cache/*.json
src/candidate-generation/cache/umls_bridge_cache.json

# ---------------------------------------------------------------- run outputs
# Per-mention prediction dumps (regenerated by eval runs)
preds_*.jsonl

# Candidate / mention dumps produced by the retrievers
cands_*.jsonl
mentions_*.jsonl

# Analysis outputs (regenerated by src/analyze_*.py)
output/
results/
finding*.json
points_*.json
evaluation_log.json
pipeline_evaluation_log.json
visualizations/**

# Cluster stdout/stderr (43 MB and growing; keep on Bender)
bender_logs/
*.log
slurm-*.out

# ---------------------------------------------------------------- paper
# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
paper/main.pdf

# Regenerable bundles and page renders
paper/acl/NEL_paper_overleaf.zip
paper/_scratch/
paper/pg-*.jpg
slide-*.jpg

# PNG previews - only the PDFs the paper actually loads are tracked
figures/**/*.png
paper/**/*.png

# Superseded figures: figures/final/ is the paper's set, the rest are dead output
figures/*.pdf
figures/drafts/*.pdf

# Reference papers (PDFs of other people's work; do not redistribute)
refs/

# Meeting decks: the .pptx source is tracked, the exported PDF is not
frederik_analysis_deck.pdf

# ---------------------------------------------------------------- misc
# Environment variables / secrets
.env

# personal error_analysis tools
/src/candidate-generation/error_analysis.py
/src/candidate-generation/deep_diagnosis.py
